with open("sample.txt", "w") as file:
    file.write("Hello, World!\nWelcome to Python file handling.\n")

# 2. Reading from a file
with open("sample.txt", "r") as file:
    content = file.read()
    print("File Content:\n", content)

# 3. Reading line by line
with open("sample.txt", "r") as file:
    print("Line-by-line reading:")
    for line in file:
        print("-", line.strip())





9.	Python Programs to demonstrate the use of various modes of files.

Aim:
To write Python programs to demonstrate the use of various file modes.



Source code:

# Demonstrate various file modes in Python

# 1. Write mode
f = open("sample.txt", "w")
f.write("Hello, Python!\n")
f.write("Learning file handling.")
f.close()
print("Write mode executed.")

# 2. Read mode
f = open("sample.txt", "r")
print("\nRead mode:")
print(f.read())
f.close()

# 3. Append mode
f = open("sample.txt", "a")
f.write("\nThis line is appended.")
f.close()
print("\nAppend mode executed.")

# 4. Read and write mode
f = open("sample.txt", "r+")
print("\nRead and write mode:")
print(f.read())
f.close()

# 5. Create mode
f = open("newfile.txt", "x")
f.write("This is a newly created file.")
f.close()
print("\nNew file created successfully.")





