class Student:

    university = "Marwadi University"

    # Instance method
    def display(self):
        print("This is an instance method")

    # Class method
    @classmethod
    def display_university(cls):
        print("University:", cls.university)

    # Static method
    @staticmethod
    def check_result(marks):
        if marks >= 70:
            print("Result: Pass")
        else:
            print("Result: Fail")


student = Student()

student.display()
Student.display_university()
Student.check_result(90)



