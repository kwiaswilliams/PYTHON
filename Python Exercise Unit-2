# PYTHON Unit 2 Practical:
# 1. Creating a list

fruits = ["Orange", "Grapes", "Carrot"]

print("Original list:", fruits)

# append()
fruits.append("Apple")
print("After appending:", fruits)

# insert()
fruits.insert(1, "Mango")
print("After inserting:", fruits)

# remove()
fruits.remove("Carrot")
print("After removing:", fruits)

# pop()
fruits.pop()
print("After poping:", fruits)

# sort()
fruits.sort()
print("After sorting:", fruits)

# reverse()
fruits.reverse()
print("After reversing:", fruits)

# len()
print("Total Length of list:", len(fruits))



# 2. Creating a tuple
numbers = (5,10,15,10,20)

print("Tuple:", numbers)

# count()
print("Count of 10:", numbers.count(10))

# index()
print("Index of 15:", numbers.index(15))

# len()
print("Length of tuple:", len(numbers))

# max()
print("Maximum value:", max(numbers))

# min()
print("Minimum value:", min(numbers))

# sum()
print("Sum of values:", sum(numbers))


# 3. Creating a dictionary
student = {
    "name": "Williams",
    "age": 18,
    "course": "Cybersecurity"
}

print("Dictionary:", student)

# keys()
print("Keys:", student.keys())

# values()
print("Values:", student.values())

# items()
print("Items:", student.items())

# get()
print("Student name:", student.get("name"))

# update()
student.update({"age": 20})
print("After update:", student)

# pop()
student.pop("age")
print("After pop:", student)

# len()
print("Length:", len(student))




