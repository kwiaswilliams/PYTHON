5.	Write a Python program to use the dig command to find the IP address of a website (example: google.com). Also, display the DNS records of a given domain.

Source Code:

import subprocess
import shutil

def run_dig(domain):
    if shutil.which("dig"):
        for record in ["A", "MX", "NS"]:
            print(f"\n--- {record} Records for {domain} ---")
            cmd = ["dig", domain, "+short"] if record == "A" else ["dig", domain, record, "+short"]
            print(subprocess.run(cmd, capture_output=True, text=True).stdout.strip())
    else:
        print("--- NSLOOKUP Output ---")
        print(subprocess.run(["nslookup", domain], capture_output=True, text=True).stdout)

run_dig("google.com")


